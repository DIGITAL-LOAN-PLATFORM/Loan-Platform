@* @page "/guarantors"
@using Application.DTO
@using Application.Interfaces
@using Application.Services.Guarantors
@using Domain.Entities
@using LoanPlatform.Components.Dialogs
@inject IGuarantorService GuarantorService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-4">Guarantors</MudText>

    <MudPaper Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h6">Guarantors List</MudText>
            <MudButton OnClick="AddGuarantorAsync" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                Add
            </MudButton>
        </MudStack>
        <MudTable Items="_guarantors" Dense="true" Hover="true" Outlined="true">
            <HeaderContent>
                <MudTh>ID NUMBER</MudTh>
                <MudTh>NAME</MudTh>
                <MudTh>EMAIL</MudTh>
                <MudTh>PHONE</MudTh>
                <MudTh>GUARANTOR TYPE</MudTh>
                <MudTh>LOAN APPLICATION</MudTh>
                <MudTh>ADDRESS</MudTh>
                <MudTh>ACTIONS</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.IdentificationNumber</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Email</MudTd>
                <MudTd>@context.Phone</MudTd>
                <MudTd>@context.GuarantorType?.Name</MudTd>
                <MudTd>@context.LoanApplication?.ApplicationNumber</MudTd>
                <MudTd>@($"{context.Province}, {context.District}")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" OnClick="() => ViewGuarantorAsync(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => EditGuarantorAsync(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteGuarantorAsync(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<Domain.Entities.Guarantor> _guarantors = new();

    protected override async Task OnInitializedAsync()
    {
        _guarantors = await GuarantorService.GetAllAsync();
    }

    private async Task AddGuarantorAsync()
    {
        var parameters = new DialogParameters
        {
            { "Model", new UpdateGuarantorDTO() }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<GuarantorDialog>("Add Guarantor", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is UpdateGuarantorDTO dto)
        {
            var createDto = new CreateGuarantorDTO
            {
                IdentificationNumber = dto.IdentificationNumber,
                Name = dto.Name,
                Email = dto.Email,
                Phone = dto.Phone,
                GuarantorTypeId = dto.GuarantorType?.Id,
                GuarantorType = dto.GuarantorType,
                DOB = dto.DOB,
                LoanApplicationId = dto.LoanApplicationId,
                Province = dto.Province,
                District = dto.District,
                Sector = dto.Sector,
                Cell = dto.Cell,
                Village = dto.Village
            };
            
            await GuarantorService.CreateGuarantorAsync(createDto);
            await OnInitializedAsync();
            Snackbar.Add("Guarantor created successfully", Severity.Success);
        }
    }

    private async Task EditGuarantorAsync(Domain.Entities.Guarantor guarantor)
    {
        var dto = new UpdateGuarantorDTO
        {
            Id = guarantor.Id,
            IdentificationNumber = guarantor.IdentificationNumber ?? "",
            Name = guarantor.Name ?? "",
            Email = guarantor.Email ?? "",
            Phone = guarantor.Phone ?? "",
            GuarantorType = guarantor.GuarantorType,
            DOB = guarantor.DOB ?? default,
            LoanApplicationId = guarantor.LoanApplicationId,
            Province = guarantor.Province ?? "",
            District = guarantor.District ?? "",
            Sector = guarantor.Sector ?? "",
            Cell = guarantor.Cell ?? "",
            Village = guarantor.Village ?? ""
        };

        var parameters = new DialogParameters
        {
            { "Model", dto }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<GuarantorDialog>("Edit Guarantor", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is UpdateGuarantorDTO updatedDto)
        {
            await GuarantorService.UpdateGuarantorAsync(updatedDto);
            await OnInitializedAsync();
            Snackbar.Add("Guarantor updated successfully", Severity.Success);
        }
    }

    private async Task ViewGuarantorAsync(Domain.Entities.Guarantor guarantor)
    {
        var dto = new UpdateGuarantorDTO
        {
            Id = guarantor.Id,
            IdentificationNumber = guarantor.IdentificationNumber ?? "",
            Name = guarantor.Name ?? "",
            Email = guarantor.Email ?? "",
            Phone = guarantor.Phone ?? "",
            GuarantorType = guarantor.GuarantorType,
            DOB = guarantor.DOB ?? default,
            LoanApplicationId = guarantor.LoanApplicationId,
            Province = guarantor.Province ?? "",
            District = guarantor.District ?? "",
            Sector = guarantor.Sector ?? "",
            Cell = guarantor.Cell ?? "",
            Village = guarantor.Village ?? ""
        };

        var parameters = new DialogParameters
        {
            { "Model", dto },
            { "IsReadOnly", true }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<GuarantorDialog>("View Guarantor", parameters, options);
        await dialog.Result;
    }

    private async Task DeleteGuarantorAsync(Domain.Entities.Guarantor guarantor)
    {
        var parameters = new DialogParameters
        {
            { "Title", "Confirm Delete" },
            { "Message", $"Are you sure you want to delete {guarantor.Name}?" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Delete", parameters);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            await GuarantorService.DeleteGuarantorAsync(guarantor.Id);
            await OnInitializedAsync();
            Snackbar.Add("Guarantor deleted successfully", Severity.Success);
        }
    }
} *@

@page "/guarantors"
@using Application.Services.Guarantors
@using Domain.Entities
@using Application.Interfaces
@using Entity = Domain.Entities 

@inject IGuarantorService GuarantorService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <div class="d-flex align-center justify-space-between mb-6">
        <MudText Typo="Typo.h5" Style="font-weight: 800; color: #1B2559;">Collateral Assets</MudText>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add" 
                   OnClick="OpenCreateDialog">
            Add Guarantor
        </MudButton>
    </div>

    @* Explicitly define the Type T as the Domain Entity *@
    <MudDataGrid T="Entity.Guarantor" Items="@_guarantor" Hover="true" Elevation="0" Class="rounded-xl">
        <Columns>

            @* <PropertyColumn Property="x => x.LoanApplication.ApplicationCode" Title="Asset Name" /> *@
            <PropertyColumn Property="x => x.IdentificationNumber" Title="ID Number" />
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Phone" Title="Phone" />
            <PropertyColumn Property="x => x.Email" Title="Email" />
            <TemplateColumn Title="Location">
                <CellTemplate>
                    @($"{context.Item.Province}, {context.Item.District}")
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn CellClass="d-flex justify-end">
                <CellTemplate>
                    @* <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                   Size="Size.Small" 
                                   OnClick="@(() => OpenEditDialog(context.Item.Id))" /> *@
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                   Color="Color.Error" 
                                   Size="Size.Small" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Entity.Guarantor" />
        </PagerContent>
    </MudDataGrid>
</MudContainer>

@code {
    // Using full namespace to avoid 'Web.Components.Pages.Collateral' conflict
    private List<Entity.Guarantor> _guarantor = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        // This calls your Repository.GetAllGuarantorsAsync()
        _guarantor = await GuarantorService.GetAllAsync();
        StateHasChanged();
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<GuarantorDialog>("Register New Guarantor", options);
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled) 
        {
            await LoadData();
        }
    }

    @* private async Task OpenEditDialog(int id)
    {
        var parameters = new DialogParameters { ["Id"] = id };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        
        // You would create an EditCollateralDialog similar to your Create dialog
        var dialog = await DialogService.ShowAsync<EditCollateralDialog>("Update Collateral", parameters, options);
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled) 
        {
            await LoadData();
        }
    } *@
}